-- 1. Buffer pool warm-cache check
SHOW GLOBAL STATUS LIKE 'Innodb_buffer_pool_reads';
SHOW GLOBAL STATUS LIKE 'Innodb_buffer_pool_read_requests';
SELECT table_name, table_rows,
       ROUND(data_length / 1024 / 1024, 2) AS data_mb,
       ROUND(index_length / 1024 / 1024, 2) AS index_mb
FROM information_schema.tables
WHERE table_schema = DATABASE()
  AND table_name IN ('transactions', 'usage_daily');

-- 2. Candidate column-order experiment (INVISIBLE first)
ALTER TABLE transactions
  ADD INDEX idx_tx_status_created_test (status, created_at, type, currency, amount) INVISIBLE;

SET SESSION optimizer_switch = 'use_invisible_indexes=on';
EXPLAIN
SELECT DATE(created_at) AS d, status, type, currency, COUNT(*) AS cnt, SUM(amount) AS amt
FROM transactions
WHERE created_at >= '2025-11-27 00:00:00'
  AND created_at <  '2026-11-27 00:00:00'
  AND status IN ('SUCCESS', 'FAILED', 'ROLLED_BACK')
GROUP BY d, status, type, currency;

-- Drop candidate after proving hypothesis
ALTER TABLE transactions DROP INDEX idx_tx_status_created_test;

-- 3. Unused / redundant index audit
SELECT * FROM sys.schema_unused_indexes WHERE object_schema = DATABASE();
SELECT * FROM sys.schema_redundant_indexes WHERE table_schema = DATABASE();